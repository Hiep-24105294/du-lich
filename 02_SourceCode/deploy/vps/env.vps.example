# Chép thành deploy/vps/.env trên VPS (chmod 600). Mọi giá trị bí mật PHẢI đổi.
# Sinh chuỗi ngẫu nhiên: openssl rand -hex 32
APP_ENV=production
APP_DEBUG=false
APP_URL=https://DISANSO_DOMAIN
APP_KEY=
LOG_LEVEL=info
LOG_STACK=daily
LOG_DAILY_DAYS=14

DB_DATABASE=disanso
DB_USERNAME=disanso
DB_PASSWORD=DOI-THANH-CHUOI-NGAU-NHIEN
DB_ROOT_PASSWORD=DOI-THANH-CHUOI-NGAU-NHIEN-KHAC

# Cổng web trên 127.0.0.1 mà nginx trỏ vào (khớp nginx-disanso.conf)
APP_FORWARD_PORT=8080
ANALYTICS_TOKEN=DOI-THANH-CHUOI-NGAU-NHIEN-32-KY-TU

# Để trống: entrypoint tự sinh và lưu trong volume app_storage
PAYMENT_SANDBOX_SECRET=
SEED_DEMO_PASSWORD=DOI-MAT-KHAU-TAI-KHOAN-MAU
MAP_PROVIDER=google
