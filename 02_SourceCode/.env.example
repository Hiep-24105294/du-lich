# Sao chép thành .env ở cùng thư mục với compose.yaml rồi chỉnh nếu cần.
# Mọi giá trị dưới đây là dữ liệu mô phỏng cho môi trường học tập.
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=
LOG_LEVEL=info

DB_DATABASE=disanso
DB_USERNAME=disanso
DB_PASSWORD=disanso_secret
DB_ROOT_PASSWORD=root_secret
DB_FORWARD_PORT=3307

APP_FORWARD_PORT=8080
ANALYTICS_FORWARD_PORT=8001
ANALYTICS_TOKEN=dev-analytics-token

# Để trống: hệ thống tự sinh khóa ký thanh toán sandbox khi khởi động lần đầu
PAYMENT_SANDBOX_SECRET=
# Chỉ đặt "*" khi chạy sau proxy của nền tảng (Railway/Render)
TRUSTED_PROXIES=
SEED_DEMO_PASSWORD=DiSan@2026
SESSION_SECURE_COOKIE=false
